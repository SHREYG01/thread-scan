# ==============================================================================
# THREAD//SCAN - Root Git Ignore Configuration
# ==============================================================================

# Node.js dependencies & package managers
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build artifacts & caches
.next/
**/.next/
out/
**/out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel/

# C++ compiled binaries & object files
*.exe
*.o
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.a
*.so
*.dll
*.dylib
backend/*.exe

# Environment configuration files
.env
.env.*
!.env.example

# Temporary runtime, test & scratch data
scratch/
.agents/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor metadata
.vscode/
.idea/
*.suo
*.user
*.userosv
*.sln.docstates
*.swp
*.swo

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
[Nn]et[Hh]ood
[Dd]rop[Bb]ox
